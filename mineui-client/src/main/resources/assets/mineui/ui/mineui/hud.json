{
  "type": "column",
  "skin": "mineui:glass",
  "gap": 5,
  "children": [
    {
      "type": "row",
      "gap": 7,
      "align": "center",
      "children": [
        { "type": "item", "item": "minecraft:music_disc_cat", "scale": 1.4 },
        {
          "type": "column",
          "gap": 1,
          "children": [
            { "type": "text", "text": "{state.title}", "color": "#F0F4F8" },
            { "type": "text", "text": "{state.subtitle}", "color": "#9FB0C0" }
          ]
        }
      ]
    },
    {
      "type": "progress",
      "width": 140,
      "height": 10,
      "radius": 5,
      "background": "#33FFFFFF",
      "color": "#5AA9E6",
      "fillGradient": ["#5AA9E6", "#8A5FD0"],
      "value": "{state.position}",
      "min": 0,
      "max": 180,
      "playing": "{state.playing}",
      "interpolate": true,
      "text": "{value} / {max}",
      "timeFormat": "mm:ss",
      "textColor": "#C8D8E8"
    }
  ]
}
