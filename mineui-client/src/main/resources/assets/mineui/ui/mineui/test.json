{
  "type": "column",
  "id": "root",
  "width": "100%",
  "height": "100%",
  "padding": 24,
  "gap": 10,
  "align": "center",
  "justify": "center",
  "children": [
    {
      "type": "image",
      "id": "logo",
      "texture": "mineui:textures/gui/logo.png",
      "textureSize": [16, 16],
      "regionWidth": 16,
      "regionHeight": 16,
      "width": 64,
      "height": 64
    },
    {
      "type": "text",
      "id": "title",
