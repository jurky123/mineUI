{
  "type": "column",
  "id": "root",
  "width": "100%",
  "height": "100%",
  "align": "center",
  "justify": "center",
  "children": [
    {
      "type": "column",
      "id": "card",
      "width": 300,
      "padding": 18,
      "gap": 10,
      "align": "center",
      "background": "#1B2733",
      "radius": 12,
      "border": { "color": "#3FA9F5", "width": 1 },
      "shadow": { "color": "#000000", "size": 8, "offsetY": 4 },
      "children": [
        {
          "type": "row",
          "gap": 10,
          "align": "center",
          "children": [
            {
              "type": "image",
              "texture": "mineui:textures/gui/logo.png",
              "textureSize": [16, 16],
              "regionWidth": 16,
              "regionHeight": 16,
              "width": 32,
              "height": 32
            },
            {
              "type": "text",
              "id": "title",
              "text": "{state.title}",
              "color": "#FFFFFF",
              "scale": 1.5
            }
          ]
        },
        {
          "type": "box",
          "width": "100%",
          "height": 2,
          "radius": 1,
          "gradient": ["#3FA9F5", "#1B2733"]
        },
        {
          "type": "text",
          "id": "count",
          "text": "count = {state.count}",
          "color": "#00E0FF",
          "pulse": true
        },
        {
          "type": "spacer",
          "height": 4
        },
        {
          "type": "button",
          "id": "click",
          "text": "点我 +1",
          "action": "button_click",
          "width": 160,
          "height": 26,
          "radius": 6,
          "background": "#2E5C8A",
          "hoverBackground": "#3FA9F5"
        },
        {
          "type": "text",
          "text": "Esc 关闭 · F9 热重载 JSON",
          "color": "#8090A0"
        }
      ]
    }
  ]
}
