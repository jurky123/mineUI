      "color": "#FFFFFF",
      "scale": 2.0
    },
    {
      "type": "text",
      "id": "count",
      "text": "count = {state.count}",
      "color": "#00E0FF"
    },
    {
      "type": "spacer",
      "height": 6
    },
    {
      "type": "button",
      "id": "click",
      "text": "点我 +1",
      "action": "button_click",
      "width": 140,
      "height": 22
    },
    {
      "type": "text",
      "id": "hint",
      "text": "Esc 关闭 · F9 热重载 JSON",
      "color": "#909090"
    }
  ]
}
