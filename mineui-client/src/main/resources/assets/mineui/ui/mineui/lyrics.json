{
  "type": "stack",
  "width": "100%",
  "height": "100%",
  "align": "center",
  "justify": "center",
  "children": [
    {
      "type": "column",
      "skin": "mineui:glass",
      "width": 300,
      "gap": 8,
      "align": "center",
      "children": [
        { "type": "text", "text": "歌词 / 列表（list 节点）", "color": "#FFFFFF" },
        {
          "type": "list",
          "width": 260,
          "height": 150,
          "gap": 4,
          "items": "{state.lyrics}",
          "highlightIndex": "{state.current}",
          "highlightColor": "#FFFFFF",
          "itemTemplate": {
            "type": "text",
            "text": "{item}",
            "color": "#8090A0",
            "width": "100%",
            "align": "center"
          }
        },
        { "type": "text", "text": "滚轮滚动 · 高亮行自动居中", "color": "#9FB0C0" },
        { "type": "text", "text": "按键提示：{key.mineui_demo_keybind}", "color": "#7FB07F" },
        { "type": "button", "skin": "vanilla:button", "text": "关闭", "action": "close", "width": 100 }
      ]
    }
  ]
}
