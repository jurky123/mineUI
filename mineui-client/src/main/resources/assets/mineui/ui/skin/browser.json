{
  "type": "column",
  "id": "root",
  "width": "100%",
  "height": "100%",
  "padding": 12,
  "gap": 8,
  "background": "#0B1018",
  "children": [
    {
      "type": "row",
      "id": "header",
      "width": "100%",
      "height": 26,
      "align": "center",
      "justify": "space-between",
      "children": [
        {
          "type": "row",
          "gap": 8,
          "align": "center",
          "children": [
            {
              "type": "text",
              "text": "{state.title}",
              "color": "#FFFFFF",
              "scale": 1.4
            },
            {
              "type": "text",
              "text": "{state.subtitle}",
              "color": "#8090A0"
            }
          ]
        },
        {
          "type": "row",
          "gap": 6,
          "align": "center",
          "children": [
            {
              "type": "text",
              "text": "{state.page}",
              "color": "#B0C0D0"
            },
            {
              "type": "button",
              "text": "上一页",
              "action": "prev",
              "height": 20,
              "radius": 6,
              "background": "#2E5C8A",
              "hoverBackground": "#3FA9F5"
            },
            {
              "type": "button",
              "text": "下一页",
              "action": "next",
              "height": 20,
              "radius": 6,
              "background": "#2E5C8A",
              "hoverBackground": "#3FA9F5"
            },
            {
              "type": "button",
              "text": "关闭",
              "action": "close",
              "height": 20,
              "radius": 6,
              "background": "#8A3E5A",
              "hoverBackground": "#D05F8A"
            }
          ]
        }
      ]
    },
    {
      "type": "row",
      "id": "body",
      "width": "100%",
      "height": "100%",
      "gap": 10,
      "children": [
        {
          "type": "scroll",
          "id": "list",
          "width": "57%",
          "height": "100%",
          "gap": 4,
          "children": [
            {
              "type": "row",
              "action": "slot_0",
              "width": "100%",
              "height": 26,
              "padding": { "left": 6, "right": 6 },
              "gap": 6,
              "align": "center",
              "background": "#16202C",
              "radius": 6,
              "tooltip": "{state.slots.0.tooltip}",
              "children": [
                {
                  "type": "box",
                  "width": 5,
                  "height": 16,
                  "radius": 2,
                  "background": "#3FA9F5",
                  "visible": "{state.slots.0.selected}"
                },
                { "type": "text", "text": "{state.slots.0.name}", "color": "#E0E8F0" },
                {
                  "type": "text",
                  "text": "已选",
                  "color": "#3FA9F5",
                  "visible": "{state.slots.0.selected}"
                }
