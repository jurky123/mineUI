        },
        {
          "type": "column",
          "id": "previewPanel",
          "width": "40%",
          "height": "100%",
          "padding": 10,
          "gap": 6,
          "align": "center",
          "background": "#10161F",
          "radius": 8,
          "border": { "color": "#26384A", "width": 1 },
          "children": [
            {
              "type": "text",
              "text": "3D 预览",
              "color": "#3FA9F5"
            },
            {
              "type": "player",
              "id": "preview",
              "width": "100%",
              "height": 190,
              "scale": 55,
              "followMouse": true,
              "skin": {
                "value": "{state.preview.value}",
                "signature": "{state.preview.signature}"
              }
            },
            {
              "type": "text",
              "text": "{state.preview.name}",
              "color": "#FFFFFF",
              "scale": 1.2
            },
            {
              "type": "button",
              "text": "应用该皮肤",
              "action": "apply",
              "width": 130,
              "height": 22,
              "radius": 6,
              "background": "#2E7C5A",
              "hoverBackground": "#3FBF8A"
            },
            {
              "type": "text",
              "text": "{state.status}",
              "color": "#8090A0"
            }
          ]
        }
      ]
    },
    {
      "type": "row",
      "id": "footer",
      "width": "100%",
      "height": 18,
      "align": "center",
      "justify": "space-between",
      "children": [
        { "type": "text", "text": "点击左侧皮肤选择 · 右侧可拖动视角 · Esc 关闭", "color": "#607080" },
        { "type": "text", "text": "{state.footer}", "color": "#607080" }
      ]
    }
  ]
